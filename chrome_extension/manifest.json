{
  "manifest_version": 3,
  "name": "Job Scraper",
  "version": "1.1",
  "description": "Collect job postings from open tabs and save to JSON.",
  "permissions": ["tabs", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect job tabs"
  }
}
